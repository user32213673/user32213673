# kind 로컬 레지스트리 사용 시 빌드 & 푸시:
# docker build -t localhost:5001/spring-svc:latest .
# docker push localhost:5001/spring-svc:latest
# 그리고 deployment.yaml의 image를 localhost:5001/spring-svc:latest 로 변경
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
# 실제 JAR로 교체: COPY build/libs/*.jar app.jar
# ENTRYPOINT ["java", "-jar", "app.jar"]
RUN apk add --no-cache curl
EXPOSE 8080
CMD ["sh", "-c", "while true; do sleep 30; done"]